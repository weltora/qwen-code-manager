<Page
    x:Class="QwenCodeManager.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgDeepBrush}"
    RequestedTheme="Dark">

    <StackPanel Margin="24,16" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="О программе" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource TealGradientBrush}">
                        <FontIcon Glyph="&#xEC7A;" FontSize="22" Foreground="#FF0C1214" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Qwen Code Manager" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Версия 0.2.0 (MVP)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Лаунчер и менеджер проектов для Qwen Code. Оркестрирует настоящий Qwen Code CLI: показывает проекты, их Git-состояние и последние сессии, запускает Continue / New Session в нужной директории. Не является IDE, терминалом или Git-клиентом." />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                           Text="Работает офлайн. Проекты и конфигурация Qwen не изменяются. Секреты не хранятся. Данные менеджера: %LOCALAPPDATA%\QwenCodeManager." />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>