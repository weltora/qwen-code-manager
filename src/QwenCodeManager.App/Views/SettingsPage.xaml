<Page
    x:Class="QwenCodeManager.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgDeepBrush}"
    RequestedTheme="Dark">

    <ScrollViewer Padding="24,16,24,12" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />

            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Severity="Success" />

            <!-- General -->
            <TextBlock Text="ОСНОВНЫЕ" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Исполняемый файл Qwen" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="Путь к qwen.cmd"
                                     Text="{x:Bind ViewModel.QwenExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Автоопределение" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{x:Bind ViewModel.AutoDetectQwenCommand}" />
                            <Button Grid.Column="2" Content="Обзор…" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{x:Bind ViewModel.PickQwenExecutableCommand}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.DetectedQwenText, Mode=OneWay}" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ComboBox Header="Режим запуска по умолчанию" Width="240"
                              ItemsSource="{x:Bind ViewModel.LaunchModes}"
                              SelectedItem="{x:Bind ViewModel.DefaultLaunchMode, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Projects -->
            <TextBlock Text="ПРОЕКТЫ" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Папка проектов по умолчанию" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="C:\Projects"
                                     Text="{x:Bind ViewModel.DefaultProjectsDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{x:Bind ViewModel.PickProjectsDirectoryCommand}" />
                        </Grid>
                    </StackPanel>
                    <ToggleSwitch Header="Показывать скрытые проекты" OnContent="Вкл" OffContent="Выкл"
                                  IsOn="{x:Bind ViewModel.ShowHiddenProjects, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Network -->
            <TextBlock Text="СЕТЬ" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <ToggleSwitch Header="Загрузка обложек GitHub (нужен интернет; остальное работает офлайн)"
                                  OnContent="Вкл" OffContent="Выкл"
                                  IsOn="{x:Bind ViewModel.GitHubCoverLookup, Mode=TwoWay}" />
                    <NumberBox Header="Кеш обложек (дней)" Value="{x:Bind ViewModel.CoverCacheDays, Mode=TwoWay}"
                               Minimum="1" Maximum="365" SpinButtonPlacementMode="Compact" Width="200" />
                </StackPanel>
            </Border>

            <!-- Qwen environment (read-only) -->
            <TextBlock Text="ОКРУЖЕНИЕ QWEN" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="QWEN_HOME:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.QwenHomePath, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="QWEN.md:" />
                            <Run Text="{x:Bind ViewModel.QwenMdFound, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Skills:" />
                            <Run Text="{x:Bind ViewModel.SkillsCount, Mode=OneWay}" />
                            <Run Text="установлено" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Открыть QWEN.md" Style="{StaticResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.OpenQwenMdCommand}" />
                        <Button Content="Папка Skills" Style="{StaticResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.OpenSkillsFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <TextBlock Text="ДОПОЛНИТЕЛЬНО" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Логи:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.LogsDirectory, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        <Button Content="Открыть логи" Style="{StaticResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.OpenLogsCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Очистить кеш обложек" Style="{StaticResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.ClearCacheCommand}" />
                        <Button Content="Сбросить настройки" Style="{StaticResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.ResetSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="Сохранить настройки" Style="{StaticResource TealButtonStyle}" Margin="0,6,0,20"
                    Command="{x:Bind ViewModel.SaveCommand}" AutomationProperties.Name="Сохранить настройки" />
        </StackPanel>
    </ScrollViewer>
</Page>