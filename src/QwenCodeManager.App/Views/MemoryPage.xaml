<Page
    x:Class="QwenCodeManager.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgDeepBrush}"
    RequestedTheme="Dark">

    <ScrollViewer Padding="24,16,24,12" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Память Qwen" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Qwen Code управляет собственной памятью и Skills. Менеджер только показывает состояние и открывает файлы — ничего не изменяет."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="QWEN_HOME" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="QwenHomeText" Grid.Column="1" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="QWEN.md" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="QwenMdText" Grid.Column="1" FontSize="13" Foreground="{StaticResource OkGreenBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Skills" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="SkillsText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memories" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="MemoriesText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button Content="Открыть QWEN.md" Style="{StaticResource SubtleButtonStyle}" Click="OpenQwenMd_Click" />
                        <Button Content="Папка Skills" Style="{StaticResource SubtleButtonStyle}" Click="OpenSkills_Click" />
                        <Button Content="Папка Memories" Style="{StaticResource SubtleButtonStyle}" Click="OpenMemories_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Файлы памяти принадлежат Qwen Code. Менеджер работает с ними только на чтение."
                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>