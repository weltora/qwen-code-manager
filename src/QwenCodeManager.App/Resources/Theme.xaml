<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:QwenCodeManager.App.Services">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:NullToFalseConverter x:Key="NullToFalseConverter" />

    <!-- Graphite / slate dark theme with teal accent, amber secondary. No purple, no neon. -->
    <Color x:Key="BgDeepColor">#FF121518</Color>
    <Color x:Key="BgSurfaceColor">#FF1A1E23</Color>
    <Color x:Key="BgCardColor">#FF20252B</Color>
    <Color x:Key="BgCardHoverColor">#FF262C33</Color>
    <Color x:Key="BgElevatedColor">#FF2A3038</Color>
    <Color x:Key="StrokeSoftColor">#1FFFFFFF</Color>
    <Color x:Key="TealAccentColor">#FF2E9E9E</Color>
    <Color x:Key="TealAccentHoverColor">#FF37B0B0</Color>
    <Color x:Key="AmberAccentColor">#FFD9A441</Color>
    <Color x:Key="OkGreenColor">#FF5FAF7A</Color>
    <Color x:Key="WarnAmberColor">#FFD9A441</Color>
    <Color x:Key="ErrRedColor">#FFCC6666</Color>
    <Color x:Key="TextPrimaryColor">#FFF2F4F6</Color>
    <Color x:Key="TextSecondaryColor">#FFA6ADB6</Color>
    <Color x:Key="TextTertiaryColor">#FF767E88</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccentColor}" />
    <SolidColorBrush x:Key="TealAccentHoverBrush" Color="{StaticResource TealAccentHoverColor}" />
    <SolidColorBrush x:Key="AmberAccentBrush" Color="{StaticResource AmberAccentColor}" />
    <SolidColorBrush x:Key="OkGreenBrush" Color="{StaticResource OkGreenColor}" />
    <SolidColorBrush x:Key="WarnAmberBrush" Color="{StaticResource WarnAmberColor}" />
    <SolidColorBrush x:Key="ErrRedBrush" Color="{StaticResource ErrRedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <!-- Gradient accents (subtle, no neon) -->
    <LinearGradientBrush x:Key="TealGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF17A2A2" Offset="0" />
        <GradientStop Color="#FF2FBF8F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActiveGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#33D9A441" Offset="0" />
        <GradientStop Color="#402E9E9E" Offset="0.35" />
        <GradientStop Color="#262E9E9E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AmberSoftBrush" Color="#1FD9A441" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#1F5FAF7A" />
    <SolidColorBrush x:Key="TealSoftBrush" Color="#1F2E9E9E" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FFD9A441" />

    <!-- Force WinUI control chrome dark regardless of system theme -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource TealAccentColor}" />

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="PillBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <Style x:Key="TealButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TealAccentBrush}" />
        <Setter Property="Foreground" Value="#FF0C1214" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Sidebar navigation: RadioButton styled as flat nav item -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource BgCardBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource BgElevatedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource NavActiveGradientBrush}" />
                                        <Setter Target="Indicator.Visibility" Value="Visible" />
                                        <Setter Target="Content.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="3" Height="20" CornerRadius="2"
                                    Background="{StaticResource AmberAccentBrush}" Visibility="Collapsed"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0" />
                            <ContentPresenter x:Name="Content" Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>